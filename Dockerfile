# Используем актуальную LTS-версию Node.js
FROM node:26-alpine

# Задаем изолированную рабочую директорию
WORKDIR /app

# Копируем файлы зависимостей и устанавливаем их
COPY package*.json ./
RUN npm install

# Копируем исходный код проекта
COPY . .

# Компилируем TypeScript на этапе сборки образа
RUN npx tsc

# Указываем порт приложения
EXPOSE 3100

# Запускаем скомпилированный JS-файл (строго в двойных кавычках)
CMD ["node", "dist/index.js"]
